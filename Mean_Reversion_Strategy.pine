//@version=5
strategy("Mean-Reversion: RSI + Bollinger Bands", 
         shorttitle="MR-RSI-BB",
         overlay=true,
         initial_capital=100000,
         default_qty_type=strategy.fixed,
         default_qty_value=1000,
         commission_type=strategy.commission.cash_per_contract,
         commission_value=0.00002,
         slippage=2)

// ============================================================================
// STRATEGY PARAMETERS
// ============================================================================

// RSI Settings
rsi_period = input.int(14, "RSI Period", minval=2)
rsi_oversold = input.int(30, "RSI Oversold", minval=1, maxval=50)
rsi_overbought = input.int(70, "RSI Overbought", minval=50, maxval=99)

// Bollinger Bands Settings
bb_period = input.int(20, "BB Period", minval=2)
bb_std_dev = input.float(2.0, "BB Std Dev", minval=0.1, step=0.1)

// ATR Settings
atr_period = input.int(14, "ATR Period", minval=1)
atr_multiplier = input.float(1.5, "ATR SL Multiplier", minval=0.5, step=0.1)

// Session Filter
use_session_filter = input.bool(true, "Use Session Filter")
session_start = input.int(13, "Session Start Hour (UTC)", minval=0, maxval=23)
session_end = input.int(16, "Session End Hour (UTC)", minval=0, maxval=23)

// Risk Management
use_trailing_stop = input.bool(true, "Use Trailing Stop")
breakeven_pct = input.float(50, "Move to Breakeven at % Profit", minval=0, maxval=100)

// ============================================================================
// INDICATOR CALCULATIONS
// ============================================================================

// RSI
rsi = ta.rsi(close, rsi_period)

// Bollinger Bands
[bb_upper, bb_middle, bb_lower] = ta.bb(close, bb_period, bb_std_dev)

// ATR
atr = ta.atr(atr_period)

// Session Filter
current_hour = hour(time, "UTC")
in_session = not use_session_filter or (current_hour >= session_start and current_hour < session_end)

// ============================================================================
// ENTRY CONDITIONS
// ============================================================================

// LONG Signal: RSI oversold + price at/below lower BB
long_condition = rsi < rsi_oversold and close <= bb_lower * 1.001 and in_session

// SHORT Signal: RSI overbought + price at/above upper BB
short_condition = rsi > rsi_overbought and close >= bb_upper * 0.999 and in_session

// ============================================================================
// POSITION MANAGEMENT
// ============================================================================

// Calculate SL and TP levels
sl_distance = atr * atr_multiplier

// LONG Entry
if (long_condition and strategy.position_size == 0)
    long_sl = close - sl_distance
    long_tp = bb_middle  // Target middle BB
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=long_sl, limit=long_tp)

// SHORT Entry
if (short_condition and strategy.position_size == 0)
    short_sl = close + sl_distance
    short_tp = bb_middle  // Target middle BB
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=short_sl, limit=short_tp)

// Trailing Stop to Breakeven
if (use_trailing_stop and strategy.position_size != 0)
    entry_price = strategy.opentrades.entry_price(0)
    tp_price = strategy.opentrades.exit_price(0)
    
    if (strategy.position_size > 0)  // Long position
        profit_distance = tp_price - entry_price
        current_profit = close - entry_price
        profit_pct = (current_profit / profit_distance) * 100
        
        if (profit_pct >= breakeven_pct)
            strategy.exit("Long Exit", "Long", stop=entry_price, limit=tp_price)
    
    else if (strategy.position_size < 0)  // Short position
        profit_distance = entry_price - tp_price
        current_profit = entry_price - close
        profit_pct = (current_profit / profit_distance) * 100
        
        if (profit_pct >= breakeven_pct)
            strategy.exit("Short Exit", "Short", stop=entry_price, limit=tp_price)

// ============================================================================
// VISUALIZATION
// ============================================================================

// Plot Bollinger Bands
plot(bb_upper, "BB Upper", color=color.new(color.red, 50), linewidth=1)
plot(bb_middle, "BB Middle", color=color.new(color.gray, 50), linewidth=1, style=plot.style_cross)
plot(bb_lower, "BB Lower", color=color.new(color.green, 50), linewidth=1)

// Fill BB channel
fill(plot(bb_upper), plot(bb_lower), color=color.new(color.gray, 95))

// Plot RSI levels on chart (scaled)
hline(rsi_oversold, "RSI Oversold", color=color.new(color.green, 70), linestyle=hline.style_dashed)
hline(rsi_overbought, "RSI Overbought", color=color.new(color.red, 70), linestyle=hline.style_dashed)

// Plot entry signals
plotshape(long_condition, "Long Signal", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(short_condition, "Short Signal", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small)

// Background color for session
bgcolor(in_session ? color.new(color.blue, 95) : na, title="Trading Session")

// ============================================================================
// ALERTS
// ============================================================================

// Alert conditions
alertcondition(long_condition, "Long Signal", "RSI Oversold + Price at Lower BB")
alertcondition(short_condition, "Short Signal", "RSI Overbought + Price at Upper BB")

// ============================================================================
// STRATEGY STATISTICS DISPLAY
// ============================================================================

// Create table for stats
var table stats_table = table.new(position.top_right, 2, 8, border_width=1)

if (barstate.islast)
    // Header
    table.cell(stats_table, 0, 0, "Metric", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(stats_table, 1, 0, "Value", bgcolor=color.new(color.gray, 80), text_color=color.white)
    
    // Stats
    table.cell(stats_table, 0, 1, "Net Profit", text_color=color.white)
    table.cell(stats_table, 1, 1, str.tostring(strategy.netprofit, "#,###.##"), 
               text_color=strategy.netprofit > 0 ? color.green : color.red)
    
    table.cell(stats_table, 0, 2, "Win Rate", text_color=color.white)
    win_rate = strategy.wintrades / strategy.closedtrades * 100
    table.cell(stats_table, 1, 2, str.tostring(win_rate, "#.##") + "%", 
               text_color=win_rate > 55 ? color.green : color.red)
    
    table.cell(stats_table, 0, 3, "Profit Factor", text_color=color.white)
    table.cell(stats_table, 1, 3, str.tostring(strategy.grossprofit / strategy.grossloss, "#.##"), 
               text_color=strategy.grossprofit / strategy.grossloss > 1.5 ? color.green : color.red)
    
    table.cell(stats_table, 0, 4, "Total Trades", text_color=color.white)
    table.cell(stats_table, 1, 4, str.tostring(strategy.closedtrades), text_color=color.white)
    
    table.cell(stats_table, 0, 5, "Wins / Losses", text_color=color.white)
    table.cell(stats_table, 1, 5, str.tostring(strategy.wintrades) + " / " + str.tostring(strategy.losstrades), 
               text_color=color.white)
    
    table.cell(stats_table, 0, 6, "Avg Win / Loss", text_color=color.white)
    table.cell(stats_table, 1, 6, str.tostring(strategy.grossprofit / strategy.wintrades, "#.##") + " / " + 
               str.tostring(strategy.grossloss / strategy.losstrades, "#.##"), text_color=color.white)
    
    table.cell(stats_table, 0, 7, "Max Drawdown", text_color=color.white)
    table.cell(stats_table, 1, 7, str.tostring(strategy.max_drawdown, "#,###.##"), 
               text_color=strategy.max_drawdown < -15000 ? color.red : color.orange)

// ============================================================================
// NOTES
// ============================================================================

// Strategy Logic:
// 1. LONG when RSI < 30 and price touches lower Bollinger Band
// 2. SHORT when RSI > 70 and price touches upper Bollinger Band
// 3. Take Profit at middle Bollinger Band (20 SMA)
// 4. Stop Loss at 1.5x ATR from entry
// 5. Move SL to breakeven when 50% profit reached
// 6. Optional session filter for London/NY overlap (1-4 PM UTC)
//
// Expected Performance:
// - Win Rate: 55-65%
// - Profit Factor: 1.5-2.0
// - Trades per month: 40-60 per pair
// - Best on M15 timeframe for EUR/USD, GBP/USD, USD/JPY
